# Copy this file to .env and fill in the values. Never commit .env.

# Password for the PostgreSQL user "formelx" (used by docker-compose.yml).
POSTGRES_PASSWORD=

# Where the app finds its database. For local development with `docker compose up -d db`:
#   postgresql+asyncpg://formelx:<POSTGRES_PASSWORD>@localhost:5432/formelx
# docker-compose.yml sets this itself for the app container.
DATABASE_URL=

# Random secret that signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Send the login cookie over HTTPS only. Set to false for local development on http://.
SECURE_COOKIES=false

# Optional host ports for docker compose (defaults 8000 and 5432).
# APP_PORT=8000
# DB_PORT=5432

# Only for the one-time import from the old Supabase project (python -m src.backend.import_supabase).
# Delete these once the import is done.
SUPABASE_URL=
SUPABASE_KEY=
