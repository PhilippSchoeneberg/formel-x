# Copy this file to .env and fill in the values. Never commit .env.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Server-side Supabase key. Use the service_role key (Project Settings → API), which only
# the backend ever sees. It bypasses row level security, so keep it secret.
SUPABASE_KEY=

# Random secret that signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Send the login cookie over HTTPS only. Set to false for local development on http://.
SECURE_COOKIES=false
