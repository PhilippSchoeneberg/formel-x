# Copy this file to .env and fill in the values. Never commit .env (it's in .gitignore).
# Generate random values with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Server (compose.yaml) -----------------------------------------------------------------

# Public domain without https://. The app rejects requests for any other Host header.
PUBLIC_HOST=formel-x.duckdns.org

# Password for the PostgreSQL user "formelx". Letters, digits, - and _ only (it's put into a URL).
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Signs the login cookie; at least 32 characters. Changing it logs everyone out.
SESSION_SECRET=change-me-to-a-random-value-of-at-least-32-characters

# Login cookie only over HTTPS. Keep true on the server (Caddy serves HTTPS).
# Set to false only for local development on plain http://localhost.
SECURE_COOKIES=true

# Optional: whose X-Forwarded-* headers to trust (default "*": every container on the "web"
# network). Narrow it to Caddy's address if you like, see doc/deployment.md.
# FORWARDED_ALLOW_IPS=*

# --- Local development only ----------------------------------------------------------------

# Used when running `uv run uvicorn …` on your machine against the database from compose.dev.yaml.
# compose.yaml sets its own value for the container.
DATABASE_URL=postgresql+asyncpg://formelx:<POSTGRES_PASSWORD>@localhost:5432/formelx

# Host ports for compose.dev.yaml (defaults 8000 and 5432).
# APP_PORT=8000
# DB_PORT=5432

# --- One-time import from the old Supabase project ------------------------------------------
# (uv run python -m src.backend.import_supabase). Delete these once the import is done.
SUPABASE_URL=
SUPABASE_KEY=
