<ModesMenuScreen>:
    BoxLayout:
        orientation: 'vertical'

        MDTopAppBar:
            type: "small"
            size_hint_x: 1

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    id: theme_mode
                    icon: "weather-sunny"
                    on_release: app.change_theme()

            MDTopAppBarTitle:
                text: "FormulaX"
                pos_hint: {"center_x": .5}

            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    id: account_button
                    icon: "account"

        ScrollView:
            MDList:
                id: mode_list

        MDTopAppBar:
            type: "small"
            size_hint_x: 1

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    id: choose_group_button
                    icon: "autorenew"
                    on_release: app.modesMenuScreen.group_menu_open()

            MDTopAppBarTitle:
                id: group_name
                text: "Select Group"

            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    id: create_or_add_group_button
                    icon: "plus"

                MDActionTopAppBarButton:
                    id: edit_group_button
                    icon: "border-color"
                    on_release: app.modesMenuScreen.edit_group()

                MDActionTopAppBarButton:
                    id: delete_or_remove_group_button
                    icon: "exit-to-app"
