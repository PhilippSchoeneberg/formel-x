<CompoundLearningScreen>:
    BoxLayout:
        orientation: 'vertical'

        MDTopAppBar:
            type: "small"
            size_hint_x: 1

            MDTopAppBarLeadingButtonContainer:

                MDActionTopAppBarButton:
                    id: theme_mode
                    icon: "weather-sunny"
                    on_release: app.change_theme()

            MDTopAppBarTitle:
                text: "FormulaX"
                pos_hint: {"center_x": .5}

            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    id: create_compound_button
                    icon: "plus-circle"
                    on_release: app.create_compound_popup_menu.open()

                MDActionTopAppBarButton:
                    id: edit_compound_button
                    icon: "border-color"
                    on_release: app.group_menu_open(*args)

                MDActionTopAppBarButton:
                    id: delete_compound_button
                    icon: "delete"
                    on_release: app.compoundLearningScreen.delete_compound()

                MDActionTopAppBarButton:
                    id: back_button
                    icon: "arrow-left"
                    on_release: app.change_screen("compoundMenu")

        ScrollView:
            MDList:
                id: compound_learning_list
