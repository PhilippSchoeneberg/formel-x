<CompoundMenuScreen>:
    BoxLayout:
        orientation: 'vertical'

        MDTopAppBar:
            type: "small"
            size_hint_x: 1

            MDTopAppBarLeadingButtonContainer:

                MDActionTopAppBarButton:
                    id: theme_mode
                    icon: "weather-sunny"
                    on_release: app.change_theme()

            MDTopAppBarTitle:
                text: "FormulaX"
                pos_hint: {"center_x": .5}

            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    id: create_category_or_compound_button
                    icon: "plus-circle"
                    on_release: app.compoundMenuScreen.create_or_edit_category_or_compound_menu_open()

                MDActionTopAppBarButton:
                    id: edit_category_button
                    icon: "border-color"
                    on_release: app.compoundMenuScreen.edit_category()

                MDActionTopAppBarButton:
                    id: delete_category_button
                    icon: "delete"
                    on_release: app.delete_category_popup_menu.open()

                MDActionTopAppBarButton:
                    id: back_button
                    icon: "arrow-left"
                    on_release: app.change_screen("modesMenu")

        ScrollView:
            MDList:
                id: category_list
