<ElementMenuScreen>:
    BoxLayout:
        orientation: 'vertical'

        MDTopAppBar:
            type: "small"
            size_hint_x: 1

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    id: theme_mode
                    icon: "weather-sunny"
                    on_release: app.change_theme()

            MDTopAppBarTitle:
                text: "FormulaX"
                pos_hint: {"center_x": .5}

            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    id: back_button
                    icon: "arrow-left"
                    on_release: app.change_screen("modesMenu")

        MDList:
            id: element_learning_list

        ScrollView:
            do_scroll_x: True
            do_scroll_y: False

            MDBoxLayout:
                id: periodic_table
                orientation: "vertical"
                size_hint: None, None
                width: self.minimum_width
                height: self.minimum_height

        MDTopAppBar:
            type: "small"
            size_hint_x: 1

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    id: switch_learning_mode_button
                    icon: "autorenew"
                    on_release: app.element_menu_screen.switch_learning_mode()

            MDTopAppBarTitle:
                id: learning_mode_title
                text: "Remembering Mode"
