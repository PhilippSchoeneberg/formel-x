<MainMenuScreen>:
    BoxLayout:
        orientation: 'vertical'

        MDTopAppBar:
            type: "small"
            size_hint_x: 1

            MDTopAppBarLeadingButtonContainer:

                MDActionTopAppBarButton:
                    id: theme_mode
                    icon: "weather-sunny"
                    on_release: app.change_theme()

            MDTopAppBarTitle:
                text: "FormulaX"
                pos_hint: {"center_x": .5}

            MDTopAppBarTrailingButtonContainer:

                MDActionTopAppBarButton:
                    id: account_button
                    icon: "account"
                    on_release: app.login_account_popup_menu.open()
        ScrollView:
            MDList:
                id: mode_list
