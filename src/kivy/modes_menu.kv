<ModesMenuScreen>:
    BoxLayout:
        id: main_box
        orientation: 'vertical'

        MDTopAppBar:
            type: "small"
            size_hint_x: 1

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    id: account_button
                    icon: "account"

            MDTopAppBarTitle:
                text: "FormelX"
                pos_hint: {"center_x": .5}

            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    id: general_menu_button
                    icon: "menu"
                    on_release: app.general_menu_open()

        ScrollView:
            MDList:
                id: mode_list

        MDTopAppBar:
            type: "small"
            size_hint_x: 1

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    id: select_group_button
                    icon: "autorenew"
                    on_release: app.modes_menu_screen.group_menu_open()

            MDTopAppBarTitle:
                id: group_name
